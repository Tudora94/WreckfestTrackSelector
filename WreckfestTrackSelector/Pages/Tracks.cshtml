@page
@model WreckfestTrackSelector.Pages.TracksModel

<h1>Wreckfest Track Selector</h1>
<p>Select a track for the dedicated server.</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">
        @TempData["Error"]
    </div>
}

<div class="track-grid">
    @foreach (var track in Model.Tracks)
    {
        <div class="track-card @(track.is_selected ? "selected" : "")"
             data-track-id="@track.Id"
             data-selected="@(track.is_selected.ToString().ToLower())"
             data-selected-by="@track.selected_by_browser_id">

            <!-- Thumbnail -->
            <img src="@track.thumbnail_location"
                 alt="@track.map_name"
                 class="track-thumb"
                 onerror="this.src='/images/placeholder-track.png'" />

            <!-- Track Info -->
            <div class="track-info">
                <h3>@track.map_name</h3>
                <p><strong>Variant:</strong> @track.map_variant</p>
                <p><strong>Surface:</strong> @track.track_surface</p>
                <p><strong>Length:</strong> @track.track_length m</p>
            </div>

            <!-- Select Button -->
            <form method="post" asp-page-handler="Select">
                <input type="hidden" name="trackId" value="@track.Id" />

                <button type="submit"
                        class="select-btn"
                        disabled="@(track.is_selected)">
                    @(track.is_selected ? "Selected" : "Select Track")
                </button>
            </form>

            <!-- Deselect Button (only for this user) -->
            @if (track.is_selected && track.selected_by_browser_id == Request.Cookies["browserId"])
            {
                <form method="post" asp-page-handler="Deselect">
                    <button type="submit" class="select-btn deselect-btn">
                        Deselect
                    </button>
                </form>
            }

        </div>
    }
</div>

<style>
    .track-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .track-card {
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 15px;
        background: #fafafa;
        transition: 0.2s ease;
    }

    .track-card.selected {
        opacity: 0.6;
    }

    .track-thumb {
        width: 100%;
        height: 150px;
        object-fit: cover;
        border-radius: 6px;
        background: #ddd;
    }

    .track-info {
        margin-top: 10px;
    }

    .select-btn {
        margin-top: 10px;
        width: 100%;
        padding: 10px;
        border: none;
        border-radius: 6px;
        background: #0078d4;
        color: white;
        font-weight: bold;
        cursor: pointer;
    }

    .select-btn:disabled {
        background: #888;
        cursor: not-allowed;
    }
</style>

<script>
    // Create a persistent browser ID if it doesn't exist
    if (!localStorage.getItem("browserId")) {
        localStorage.setItem("browserId", crypto.randomUUID());
    }

    // Write it into a cookie so Razor Pages can read it
    document.cookie = "browserId=" + localStorage.getItem("browserId") + "; path=/";
</script>

<style>
    .alert-warning {
        background: #fff3cd;
        border: 1px solid #ffeeba;
        padding: 10px 15px;
        border-radius: 6px;
        margin-bottom: 15px;
        color: #856404;
        font-weight: bold;
    }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<script>
    // Connect to the hub
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/trackHub")
        .build();

    connection.on("TrackSelected", function (trackId) {
        // Find the card for this track
        const card = document.querySelector(`[data-track-id='${trackId}']`);
        if (card) {
            card.classList.add("selected");

            // Disable the button
            const btn = card.querySelector("button");
            if (btn) {
                btn.disabled = true;
                btn.innerText = "Selected";
            }
        }
    });

    connection.start();
</script>

<script>
    function applyInitialSelections() {
        document.querySelectorAll(".track-card").forEach(card => {
            if (card.dataset.selected === "true") {
                card.classList.add("selected");

                const btn = card.querySelector("button");
                if (btn) {
                    btn.disabled = true;
                    btn.innerText = "Selected";
                }
            }
        });
    }

    applyInitialSelections();
</script>

<script>
    connection.on("TrackDeselected", function (browserId) {

        // Find the card selected by this browser
        const card = document.querySelector(`[data-selected-by='${browserId}']`);
        if (!card) return;

        // Remove selected styling
        card.classList.remove("selected");
        card.dataset.selected = "false";
        card.dataset.selectedBy = "";

        // Re-enable the button
        const btn = card.querySelector("button");
        if (btn) {
            btn.disabled = false;
            btn.innerText = "Select Track";
        }
    });
</script>

